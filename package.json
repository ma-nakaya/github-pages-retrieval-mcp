{
  "name": "github-pages-retrieval-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "認証が必要な Private GitHub Pages を取得するローカル stdio MCP。",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "start:plugin": "node scripts/start-plugin.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "test:unit": "tsx --test test/page-index.test.ts",
    "test": "npm run build && npm run test:unit && npm run validate:plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.58.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
